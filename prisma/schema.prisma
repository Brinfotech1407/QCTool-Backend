enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  QC_USER
  AUDITOR
}

enum RuleType {
  FIXED_RANGE
  BAND_SINGLE
  BAND_MATRIX
  ASYMMETRIC_BAND
  RATIO_PERCENT
  FORMULA
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole
  active   Boolean  @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
}

model Standard {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isGlobal Boolean @default(true)

  categories TestCategory[]

  createdAt DateTime @default(now())
}

model TestCategory {
  id   String @id @default(uuid())
  name String

  standardId String
  standard   Standard @relation(fields: [standardId], references: [id])

  companyId String?

  tests Test[]

  createdAt DateTime @default(now())
}

model Test {
  id          String  @id @default(uuid())
  name        String
  description String?

  categoryId String
  category   TestCategory @relation(fields: [categoryId], references: [id])

  companyId String?

  parameters TestParameter[]

  createdAt DateTime @default(now())
}

model TestParameter {
  id   String  @id @default(uuid())
  name String
  unit String?

  testId String
  test   Test   @relation(fields: [testId], references: [id])

  companyId String?

  defaultCriteria AcceptanceCriteria?

  ruleDefinition RuleDefinition?  // <-- NEW

  overrides CompanyParameterOverride[]

  createdAt DateTime @default(now())
}

model RuleDefinition {
  id           String   @id @default(uuid())
  parameterId  String   @unique
  ruleType     RuleType
  ruleConfig   Json
  createdAt    DateTime @default(now())

  parameter    TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
}

model AcceptanceCriteria {
  id String @id @default(uuid())

  parameterId String        @unique
  parameter   TestParameter @relation(fields: [parameterId], references: [id])

  minValue   Float?
  maxValue   Float?
  exactValue String?
}

model CompanyParameterOverride {
  id String @id @default(uuid())

  companyId   String
  parameterId String

  parameter TestParameter @relation(fields: [parameterId], references: [id])

  minValue   Float?
  maxValue   Float?
  exactValue String?

  isDisabled Boolean @default(false)
}
