enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  QC_USER
  AUDITOR
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      UserRole
  active    Boolean   @default(true)

  companyId String?        
  company   Company?       @relation(fields: [companyId], references: [id])

  createdAt DateTime  @default(now())
}


