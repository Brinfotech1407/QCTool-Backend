enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  QC_USER
  AUDITOR
}

enum RuleType {
  FIXED_RANGE
  BAND_SINGLE
  BAND_MATRIX
  ASYMMETRIC_BAND
  RATIO_PERCENT
  FORMULA
  CHEMICAL_COMPOSITION
  MECHANICAL_PROPERTIES
  GENERIC_CONDITION
  TEXT_BOOLEAN
  TEXT_NUMERIC
}

enum HitStatus {
  RECEIVED
  QC_PENDING
  QC_APPROVED
  QC_REJECTED
}

enum BatchStatus {
  CREATED
  QC_PENDING
  QC_IN_PROGRESS
  QC_COMPLETED
  TC_GENERATED
}

enum TestStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id          String              @id @default(uuid())
  name        String
  code        String              @unique
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  users       User[]
  hits        HitEntry[]
  batches     Batch[]
  testConfigs CompanyTestConfig[]
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole
  active   Boolean  @default(true)

  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id])
  hits      HitEntry[] @relation("HitCreatedBy")
  batches   Batch[]    @relation("BatchCreatedBy")

  createdAt DateTime @default(now())
}

model HitEntry {
  id        String @id @default(uuid())
  hitNumber String @unique

  gradeId         String @default("DEFAULT")
  od              Float  @default(0)
  thickness       Float  @default(0)
  length          Float  @default(0)
  condition       String @default("NA")
  weight          Float  @default(0)
  availableWeight Float  @default(0)

  inwardPartyName     String?
  inwardPartyTcNumber String?
  chemicalComposition Json
  size                String?
  quantity            Float?
  availableQuantity   Float?
  inwardDate          DateTime?

  companyId   String
  createdById String
  status      HitStatus @default(RECEIVED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)

  company   Company    @relation(fields: [companyId], references: [id])
  createdBy User       @relation("HitCreatedBy", fields: [createdById], references: [id])
  batchHits BatchHit[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, inwardDate])
  @@index([companyId])
  @@index([gradeId])
}

model Batch {
  id          String @id @default(uuid())
  batchNumber String @unique

  gradeId String @default("DEFAULT")
  condition String @default("NA")

  outwardPartyCode String?
  od               Float  @default(0)
  thickness        Float  @default(0)
  length           Float  @default(0)
  requiredSize     String?
  requiredQuantity Float

  companyId   String
  createdById String
  status      BatchStatus @default(CREATED)
  createdAt   DateTime    @default(now())

  company    Company     @relation(fields: [companyId], references: [id])
  createdBy  User        @relation("BatchCreatedBy", fields: [createdById], references: [id])
  batchTests BatchTest[]
  batchHits  BatchHit[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId])
  @@index([gradeId])
}

model BatchHit {
  id String @id @default(uuid())

  batchId String
  hitId   String

  usedQty Float

  createdAt DateTime @default(now())

  batch Batch    @relation(fields: [batchId], references: [id])
  hit   HitEntry @relation(fields: [hitId], references: [id])

  @@index([batchId])
  @@index([hitId])
}

model Standard {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isGlobal Boolean @default(true)

  categories         TestCategory[]
  companyTestConfigs CompanyTestConfig[]

  createdAt DateTime @default(now())
}

model TestCategory {
  id   String @id @default(uuid())
  name String

  standardId String
  standard   Standard @relation(fields: [standardId], references: [id])

  companyId String?

  tests              Test[]
  companyTestConfigs CompanyTestConfig[]

  createdAt DateTime @default(now())
}

model Test {
  id          String  @id @default(uuid())
  name        String
  description String?

  categoryId String
  category   TestCategory @relation(fields: [categoryId], references: [id])

  companyId String?

  parameters         TestParameter[]
  companyTestConfigs CompanyTestConfig[]
  batchTests         BatchTest[]

  createdAt DateTime @default(now())
}

model BatchTest {
  id        String     @id @default(uuid())
  batchId   String
  testId    String
  sequence  Int
  status    TestStatus @default(PENDING)
  createdAt DateTime   @default(now())

  batch Batch @relation(fields: [batchId], references: [id])
  test  Test  @relation(fields: [testId], references: [id])

  @@unique([batchId, testId])
  @@index([batchId, status])
}

model CompanyTestConfig {
  id         String   @id @default(uuid())
  companyId  String
  standardId String
  categoryId String
  testId     String
  sequence   Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  company  Company      @relation(fields: [companyId], references: [id])
  standard Standard     @relation(fields: [standardId], references: [id])
  category TestCategory @relation(fields: [categoryId], references: [id])
  test     Test         @relation(fields: [testId], references: [id])

  @@unique([companyId, categoryId, testId])
  @@unique([companyId, categoryId, sequence])
  @@index([companyId, standardId])
  @@index([companyId, categoryId])
}

model TestParameter {
  id   String  @id @default(uuid())
  name String
  unit String?

  testId String
  test   Test   @relation(fields: [testId], references: [id])

  companyId String?

  defaultCriteria AcceptanceCriteria?

  ruleDefinition RuleDefinition? // <-- NEW

  overrides CompanyParameterOverride[]

  createdAt DateTime @default(now())
}

model RuleDefinition {
  id          String   @id @default(uuid())
  parameterId String   @unique
  ruleType    RuleType
  ruleConfig  Json
  createdAt   DateTime @default(now())

  parameter TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
}

model AcceptanceCriteria {
  id String @id @default(uuid())

  parameterId String        @unique
  parameter   TestParameter @relation(fields: [parameterId], references: [id])

  minValue   Float?
  maxValue   Float?
  exactValue String?
}

model CompanyParameterOverride {
  id String @id @default(uuid())

  companyId   String
  parameterId String

  parameter TestParameter @relation(fields: [parameterId], references: [id])

  minValue   Float?
  maxValue   Float?
  exactValue String?

  isDisabled Boolean @default(false)
}
